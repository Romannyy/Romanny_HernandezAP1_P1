@page "/Huacales/Edit/{IdEntrada:int}"

@inject EntradasHuacalesService HuacalesService
@inject TipoHuacalesService TipoHuacalesService
@inject NavigationManager Navigation
@inject ToastService ToastService

@rendermode InteractiveServer

<PageTitle>Editar Entrada</PageTitle>

@if (entrada == null)
{
    <p>Cargando...</p>
}
else
{
    <EditForm Model="entrada" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="container mt-4">
            <div class="card shadow-lg">

                <div class="card-header">
                    <h4 class="mb-0">Editar entrada de huacales</h4>
                </div>

                <div class="card-body">

                    <div class="mb-3">
                        <label class="form-label fw-bold">ID Entrada</label>
                        <input type="text" class="form-control" value="@entrada.IdEntrada" readonly />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Nombre Cliente</label>
                        <InputText class="form-control" @bind-Value="entrada.NombreCliente" />
                        <ValidationMessage For="() => entrada.NombreCliente" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">Fecha</label>
                        <InputDate class="form-control" @bind-Value="entrada.Fecha" />
                        <ValidationMessage For="() => entrada.Fecha" />
                    </div>

                    <div class="border border-success  p-3 mb-3">
                        <h5 class="mb-3">Entradas del cliente</h5>

                        <div class="row g-2 align-items-end mb-4">

                            <div class="col-md-4">
                                <label>Tipo</label>
                                <div class="input-group">
                                    <InputSelect class="form-select" @bind-Value="TipoIdSeleccionado">
                                        <option value="0">Seleccione</option>
                                        @foreach (var tipo in listaTipos)
                                        {
                                            <option value="@tipo.TipoId">@tipo.Descripcion</option>
                                        }
                                    </InputSelect>
                                </div>
                            </div>

                            <div class="col-md-2">
                                <label>Cantidad</label>
                                <InputNumber class="form-control" @bind-Value="detalleActual.Cantidad" />
                            </div>

                            <div class="col-md-2">
                                <label>Precio</label>
                                <InputNumber class="form-control" @bind-Value="detalleActual.Precio" />
                            </div>

                            <div class="col-md-2">
                                <button type="button" class="btn btn-primary w-100 bi bi-plus" @onclick="AgregarDetalle">
                                    Agregar
                                </button>
                            </div>

                        </div>
                        <div class="table-responsive">
                            <QuickGrid Items="@entrada.Detalle.AsQueryable()" Class="table table-striped table-bordered table-hover">

                                <PropertyColumn Property="@(d => d.TipoHuacal != null ? d.TipoHuacal.Descripcion : string.Empty)" Title="Tipo" Sortable="true" />

                                <PropertyColumn Property="@(d => d.Cantidad)" Title="Cantidad"  Sortable="true" />

                                <TemplateColumn Title="Precio"  Context="d" Sortable="true">
                                    @d.Precio.ToString("C")
                                </TemplateColumn>

                                <TemplateColumn Title="Total"  Context="d" Sortable="true">
                                    @( (d.Cantidad * d.Precio).ToString("C") )
                                </TemplateColumn>

                                <TemplateColumn  Context="d" Sortable="true">
                                    <button type="button" class="btn btn-outline-dark btn-sm bi bi-trash"
                                            @onclick="() => RemoverDetalle(d)">
                                        Eliminar
                                    </button>
                                </TemplateColumn>

                            </QuickGrid>
                        </div>
                       

                        <div class="row mt-3">
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Cantidad</label>
                                <input class="form-control text-end" value="@TotalCantidad" readonly />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label fw-bold">Importe</label>
                                <input class="form-control text-end" value="@entrada.Total.ToString("C")" readonly />
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(mensaje))
                    {
                        <div class="alert alert-danger">
                            @mensaje
                        </div>
                    }

                </div>

                <div class="card-footer text-center">
                    <button type="button" class="btn btn-outline-primary bi bi-file-earmark-text" @onclick="Nuevo"> Nuevo</button>
                    <button type="submit" class="btn btn-outline-success bi bi-file-earmark"> Guardar</button>
                    <button type="button" class="btn btn-outline-danger bi bi-trash" @onclick="MostrarModalEliminar"> Eliminar</button>
                </div>

            </div>
        </div>
    </EditForm>

    @if (mostrarModal)
    {
       <div class="alert alert-danger">
            <p>¿Desea eliminar?</p>
            <div class="me-2">
                <button type="button" class="btn btn-secondary" @onclick="CerrarModalEliminar">Cancelar</button>
                <button type="button" class="btn btn-danger" @onclick="EliminarConfirmado">Si, eliminar</button>
            </div>
       </div>
           

    }
}

@code {
    [Parameter]
    public int IdEntrada { get; set; }

    private EntradasHuacales? entrada;
    private EntradaDetalle detalleActual = new();
    private List<TipoHuacales> listaTipos = new();
    private string mensaje = string.Empty;
    private bool mostrarModal = false;
    private int existenciaSeleccionada = 0;

    private int TotalCantidad => entrada?.Detalle.Sum(d => d.Cantidad) ?? 0;

    private int TipoIdSeleccionado
    {
        get => detalleActual.TipoId;
        set
        {
            detalleActual.TipoId = value;
            existenciaSeleccionada = listaTipos.FirstOrDefault(t => t.TipoId == value)?.Existencia ?? 0;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        listaTipos = await TipoHuacalesService.ListarTodos();
        entrada = await HuacalesService.Buscar(IdEntrada);

        if (entrada?.Detalle != null)
        {
            foreach (var det in entrada.Detalle)
            {
                det.TipoHuacal = listaTipos.FirstOrDefault(t => t.TipoId == det.TipoId);
            }
        }
    }

    private void AgregarDetalle()
    {
        if (detalleActual.TipoId == 0 || detalleActual.Cantidad <= 0)
        {
            mensaje = "Debe seleccionar un tipo y especificar una cantidad mayor a cero.";
            return;
        }

        detalleActual.TipoHuacal = listaTipos.FirstOrDefault(t => t.TipoId == detalleActual.TipoId);
        entrada!.Detalle.Add(detalleActual);

        ActualizarTotal();
        detalleActual = new();
        existenciaSeleccionada = 0;
        mensaje = string.Empty;
    }

    private void RemoverDetalle(EntradaDetalle detalle)
    {
        detalleActual.TipoId = detalle.TipoId;
        detalleActual.Cantidad = detalle.Cantidad;
        detalleActual.Precio = detalle.Precio;

        entrada!.Detalle.Remove(detalle);
        ActualizarTotal();
    }

    private void ActualizarTotal() => entrada!.Total = entrada.Detalle.Sum(d => d.Cantidad * d.Precio);

    private async Task Guardar()
    {
        if (!entrada!.Detalle.Any())
        {
            mensaje = "Debe agregar al menos un detalle a la entrada.";
            return;
        }

        if (await HuacalesService.Guardar(entrada))
            Navigation.NavigateTo("/Huacales/Index");
        else
            mensaje = "No se pudo modificar la entrada.";
    }

    private void Nuevo() => Navigation.NavigateTo("/Huacales/Create");

    private void MostrarModalEliminar() => mostrarModal = true;
    private void CerrarModalEliminar() => mostrarModal = false;

    private async Task EliminarConfirmado()
    {
        mostrarModal = false;
        if (await HuacalesService.Eliminar(IdEntrada))
            Navigation.NavigateTo("/Huacales/Index");
        else
            mensaje = "No se pudo eliminar la entrada.";
    }
}