@page "/Huacales/Index"

@inject EntradasHuacalesService EntradasHuacalesService
@rendermode InteractiveServer

<PageTitle>Entradas Huacales</PageTitle>

<div class="container-fluid">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center">
            <h3 class="mb-0">Registro Entradas Huacales</h3>
            <a class="btn btn-primary" href="/Huacales/Create"><i class="bi bi-plus-square"></i> Crear</a>
        </div>

        <div class="card-body">
            <div class="mb-3">
                <div class="row">
                    <div class="col-md-6">
                        <div class="input-group">
                            <span class="input-group-text">Desde</span>
                            <InputDate class="form-control" @bind-Value="Desde" />
                            <span class="input-group-text">Hasta</span>
                            <InputDate class="form-control" @bind-Value="Hasta" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-3">
                    <InputSelect class="form-select" @bind-Value="Filtros">
                        <option disabled value="">Elige un filtro</option>
                        <option value="Id">ID</option>
                        <option value="Nombre">Nombre</option>
                    </InputSelect>
                </div>

                <div class="col-md-5">
                    <div class="input-group">
                        <InputText class="form-control" @bind-Value="ValorFiltro" placeholder="Buscar..." />
                        <button class="btn btn-primary" @onclick="Buscar">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                        <button type="button" class="btn btn-outline-primary bi bi-arrow-counterclockwise" @onclick="Restablecer"></button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <QuickGrid Items="ListaHuacales" Class="table table-striped table-bordered table-hover">
                    <PropertyColumn Property="@(e => e.IdEntrada)" Title="ID" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Fecha)" Format="dd/MM/yyyy" Sortable="true" />
                    <PropertyColumn Property="@(e => e.NombreCliente)" Title="Cliente" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Detalle.Sum(d => d.Cantidad))" Title="Cantidad" Sortable="true" />

                    <TemplateColumn Title="Total">
                        @context.Total.ToString("C")
                    </TemplateColumn>

                    <TemplateColumn Title="Acciones">
                        <a class="btn btn-outline-primary btn-sm" href="/Huacales/Edit/@context.IdEntrada">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer text-end">
            <strong>Conteo: </strong> @ListaHuacales.Count() &nbsp;&nbsp;|&nbsp;&nbsp;
            <strong>Total: </strong> @TotalImporte.ToString("C")
        </div>
    </div>
</div>

@code {
    public IQueryable<EntradasHuacales> ListaHuacales { get; set; } = Enumerable.Empty<EntradasHuacales>().AsQueryable();
    public string Filtros { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; }
    public DateTime? Hasta { get; set; }

    private decimal TotalImporte => ListaHuacales.Sum(h => h.Total);

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    public async Task Buscar()
    {
        List<EntradasHuacales> resultado;

        if (!string.IsNullOrWhiteSpace(ValorFiltro))
        {
            if (Filtros == "Id" && int.TryParse(ValorFiltro, out int id))
                resultado = await EntradasHuacalesService.Listar(a => a.IdEntrada == id);
            else if (Filtros == "Nombre")
                resultado = await EntradasHuacalesService.Listar(a => a.NombreCliente.ToLower().Contains(ValorFiltro.ToLower()));
            else
                resultado = await EntradasHuacalesService.Listar(a => true);
        }
        else
        {
            resultado = await EntradasHuacalesService.Listar(a => true);
        }

        if (Desde.HasValue)
            resultado = resultado.Where(a => a.Fecha >= Desde.Value).ToList();

        if (Hasta.HasValue)
            resultado = resultado.Where(a => a.Fecha <= Hasta.Value).ToList();

        ListaHuacales = resultado.AsQueryable();
    }

    private async Task Restablecer()
    {
        Filtros = string.Empty;
        ValorFiltro = string.Empty;
        Desde = null;
        Hasta = null;
        await Buscar();
    }
}