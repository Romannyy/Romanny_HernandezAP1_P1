@page "/EntradasHuacales/Index"
@inject EntradasHuacalesService entradasHuacalesService
@rendermode InteractiveServer

<PageTitle>Entradas Huacales</PageTitle>

<div class="container-fluid">
    <div class="card shadow-lg">
        <div class="card-header d-flex justify-content-between align-content-center">
            <h3>Registro Entradas Huacales</h3>
            <a class="btn btn-primary" href="/EntradasHuacales/Create"><i class="bi bi-plus-square"></i> Crear</a>
        </div>

        <div class="card-body">
            <div class="mb-2">
                <div class="row">
                    <div class="col-md-5">
                        <div class="input-group">
                            <p class="me-1">Desde: </p>
                            <InputDate class="form-control me-3" @bind-Value="Desde"></InputDate>
                            <p class="me-1">Hasta: </p>
                            <InputDate class="form-control" @bind-Value="Hasta"></InputDate>
                        </div>
                    </div>
                </div>
            </div>
            <div class="row mb-4">
                <div class="col-md-3">
                    <InputSelect class="form-select" @bind-Value="Filtros">
                        <option disabled value="">Elige un filtro</option>
                        <option value="Id">ID</option>
                        <option value="Nombre">Nombre</option>
                    </InputSelect>
                </div>

                <div class="col-md-5">
                    <div class="input-group">
                        <InputText class="form-control" @bind-Value="ValorFiltro" placeholder="Buscar...">
                        </InputText>
                        <button class="btn btn-primary" @onclick="Buscar"> <i class="bi bi-search"></i> Buscar</button>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <QuickGrid Items="Lista" Class="table table-striped table-bordered table-hover">
                    <PropertyColumn Property="@(e => e.IdEntrada)" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Fecha)" Format="yyyy-MM-dd" Sortable="true" />
                    <PropertyColumn Property="@(e => e.NombreCliente)" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Precio)" Format="N2" Sortable="true" />
                    <PropertyColumn Property="@(e => e.Cantidad)" Sortable="true" />
                    <TemplateColumn Title="Acciones">
                        <a class="btn btn-outline-primary" href="/EntradasHuacales/Edit/@context.IdEntrada">
                            <i class="bi bi-pencil-square"></i>
                        </a>
                    </TemplateColumn>
                </QuickGrid>
            </div>
        </div>

        <div class="card-footer text-end">
            <strong>Conteo: </strong>@Lista.Count()
            <strong>Total: </strong>$ @CostoTotal().ToString("N2")
        </div>
    </div>
</div>
@code {
    public IQueryable<EntradasHuacales> Lista { get; set; } = Enumerable.Empty<EntradasHuacales>().AsQueryable();
    public string Filtros { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; } = null;
    public DateTime? Hasta { get; set; } = null;

    protected override async Task OnInitializedAsync()
    {
        await Buscar();
    }

    public async Task Buscar()
    {
        List<EntradasHuacales> resultado;

        if (!string.IsNullOrEmpty(ValorFiltro))
        {
            if (Filtros == "Id" && int.TryParse(ValorFiltro, out int id))
            {
                resultado = await entradasHuacalesService
                    .Listar(a => a.IdEntrada == id);
            }
            else if (Filtros == "Nombre")
            {
                resultado = await entradasHuacalesService
                    .Listar(a => a.NombreCliente
                    .ToLower()
                    .Contains(ValorFiltro.ToLower()));
            }
            else
            {
                resultado = await entradasHuacalesService
                    .Listar(a => a.IdEntrada > 0);
            }
        }
        else
        {
            resultado = await entradasHuacalesService
                .Listar(a => a.IdEntrada > 0);
        }

        if (Desde.HasValue)
            resultado = resultado
                .Where(a => a.Fecha >= Desde.Value)
                .ToList();

        if (Hasta.HasValue)
            resultado = resultado
                .Where(a => a.Fecha <= Hasta.Value)
                .ToList();

        Lista = resultado.AsQueryable();
    }

    public double CostoTotal()
    {
        double Costo = 0;
        foreach (var c in Lista)
        {
            Costo += c.Precio * c.Cantidad;
        }
        return Costo;

    }
}
